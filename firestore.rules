rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsPlant(id) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/plants/$(id)).data.owners;
    }
    function ownsPlantAfter(id) {
      return signedIn() && request.auth.uid in getAfter(/databases/$(database)/documents/plants/$(id)).data.owners
        && getAfter(/databases/$(database)/documents/plants/$(id)).data.get('deleting', false) != true;
    }
    function validPlant() {
      return request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.growthStage in ['unknown', 'germination', 'seedling', 'vegetative', 'flowering', 'clone', 'harvested', 'drying', 'curing', 'completed']
        && request.resource.data.environment in ['outdoor', 'indoor', 'greenhouse']
        && request.resource.data.plantedIn in ['pot', 'ground']
        && (request.resource.data.get('careMedium', null) == null || request.resource.data.careMedium in ['', 'soil', 'soilless_mix', 'coco', 'other'])
        && (request.resource.data.get('rainReception', null) == null || (request.resource.data.rainReception is map
          && request.resource.data.rainReception.keys().hasOnly(['soil', 'canopy'])
          && request.resource.data.rainReception.soil in ['yes', 'no', 'partial', 'unknown']
          && request.resource.data.rainReception.canopy in ['yes', 'no', 'partial', 'unknown']));
    }
    function growthEnded(data) {
      return data.get('status', '') == 'harvested' || data.get('harvest', null) != null || data.get('harvestedOn', null) != null
        || data.get('growthStage', '') in ['harvested', 'drying', 'curing', 'completed'];
    }
    function validWateringRepeat() {
      let repeat = request.resource.data.get('wateringRepeat', null);
      return repeat == null || repeat == resource.data.get('wateringRepeat', null)
        || (!growthEnded(request.resource.data) && request.resource.data.status == 'active'
          && repeat is map && repeat.keys().hasOnly(['enabled', 'everyDays', 'time', 'waterMl', 'timeZone', 'startOn', 'nextAt'])
          && repeat.enabled == true && repeat.everyDays is int && repeat.everyDays >= 1 && repeat.everyDays <= 365
          && repeat.waterMl is number && repeat.waterMl > 0 && repeat.waterMl <= 1000000
          && repeat.time is string && repeat.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
          && repeat.timeZone is string && repeat.timeZone.size() > 0 && repeat.timeZone.size() <= 100
          && repeat.startOn is string && repeat.startOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && repeat.nextAt is number && repeat.nextAt > 0);
    }
    function advancesCareRevision(id) {
      return !exists(/databases/$(database)/documents/plants/$(id))
        || get(/databases/$(database)/documents/plants/$(id)).data.get('careEventProtocol', 0) != 1
        || getAfter(/databases/$(database)/documents/plants/$(id)).data.get('careRevision', 0)
          == get(/databases/$(database)/documents/plants/$(id)).data.get('careRevision', 0) + 1;
    }
    // Sanitized diagnostics only: one capped record per account, no raw user content.
    match /clientDiagnostics/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if false; // A client cannot reset its daily cap by deleting the record.
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['day', 'count', 'lastSeenAt', 'operation', 'code', 'platform', 'version', 'severity'])
        && request.resource.data.day == int(request.time.toMillis() / 86400000)
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 20
        && ((!exists(/databases/$(database)/documents/clientDiagnostics/$(uid)) && request.resource.data.count == 1)
          || (exists(/databases/$(database)/documents/clientDiagnostics/$(uid)) && ((request.resource.data.day == resource.data.day && request.resource.data.count == resource.data.count + 1) || (request.resource.data.day != resource.data.day && request.resource.data.count == 1))))
        && request.resource.data.operation in ['handled', 'save', 'weather', 'render', 'unhandled']
        && request.resource.data.code in ['unknown', 'unavailable', 'deadline-exceeded', 'permission-denied', 'unauthenticated', 'network-request-failed', 'resource-exhausted']
        && request.resource.data.platform in ['web', 'android', 'ios']
        && request.resource.data.version is string && request.resource.data.version.matches('[0-9]+[.][0-9]+[.][0-9]+') && request.resource.data.version.size() <= 20
        && request.resource.data.severity in ['error', 'fatal'];
    }
    match /plants/{plantId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/plants/$(plantId)) || request.auth.uid in resource.data.owners);
      allow list: if signedIn() && request.auth.uid in resource.data.owners;
      allow create: if signedIn() && request.resource.data.owners == [request.auth.uid] && validPlant()
        && request.resource.data.get('wateringRepeat', null) == null
        && request.resource.data.get('careEvaluationRevision', null) == null
        && request.resource.data.get('careNextEvaluationUtc', null) == null
        && request.resource.data.get('careEventProtocol', 0) == 0
        && request.resource.data.get('waterLedgerRevision', 0) == 0
        && request.resource.data.get('setupLedgerRevision', 0) == 0
        && request.resource.data.get('careSummary', null) == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid in resource.data.owners && validPlant() && validWateringRepeat()
        && (!growthEnded(resource.data) || (request.resource.data.get('status', '') != 'active'
          && (request.resource.data.growthStage == resource.data.growthStage || request.resource.data.growthStage in ['harvested', 'drying', 'curing', 'completed'])))
        && request.resource.data.get('careEvaluationRevision', null) == resource.data.get('careEvaluationRevision', null)
        && request.resource.data.get('careNextEvaluationUtc', null) == resource.data.get('careNextEvaluationUtc', null)
        && request.resource.data.get('careEventProtocol', 0) == resource.data.get('careEventProtocol', 0)
        && (resource.data.get('careEventProtocol', 0) != 1
          || (request.resource.data.get('careRevision', 0) is int
            && request.resource.data.get('careRevision', 0) >= resource.data.get('careRevision', 0)))
        && request.resource.data.get('waterLedgerRevision', 0) == resource.data.get('waterLedgerRevision', 0)
        && request.resource.data.get('setupLedgerRevision', 0) == resource.data.get('setupLedgerRevision', 0)
        && (request.resource.data.get('careSummary', null) == null || (request.resource.data.careSummary.version == 1 && request.resource.data.careSummary.revision == request.resource.data.get('careRevision', 0)))
        && request.resource.data.owners == resource.data.owners
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if ownsPlant(plantId);
      match /photoAssets/{assetId} {
        allow read, delete: if ownsPlant(plantId);
        allow create: if ownsPlantAfter(plantId) && request.resource.data.keys().hasOnly(['dataUri'])
          && request.resource.data.dataUri is string
          && request.resource.data.dataUri.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
          && request.resource.data.dataUri.size() <= (assetId.matches('.*_thumb') ? 20480 : 184320);
        allow update: if false;
      }
      match /care/{snapshotId} {
        allow read: if ownsPlant(plantId);
        allow delete: if ownsPlant(plantId) && get(/databases/$(database)/documents/plants/$(plantId)).data.get('deleting', false) == true;
        allow create, update: if false;
      }
      match /careEvents/{eventId} {
        allow read, delete: if ownsPlant(plantId) && get(/databases/$(database)/documents/plants/$(plantId)).data.get('deleting', false) == true;
        allow create, update: if false;
      }
      match /careTransitions/{transitionId} {
        allow read, delete: if ownsPlant(plantId) && get(/databases/$(database)/documents/plants/$(plantId)).data.get('deleting', false) == true;
        allow create, update: if false;
      }
      match /careShadow/{runId} {
        allow read, delete: if ownsPlant(plantId) && get(/databases/$(database)/documents/plants/$(plantId)).data.get('deleting', false) == true;
        allow create, update: if false;
      }
      match /careWaterCheckpoints/{checkpointId} {
        allow read, delete: if ownsPlant(plantId) && get(/databases/$(database)/documents/plants/$(plantId)).data.get('deleting', false) == true;
        allow create, update: if false;
      }
      match /careWaterState/{stateId} {
        allow read, delete: if ownsPlant(plantId) && get(/databases/$(database)/documents/plants/$(plantId)).data.get('deleting', false) == true;
        allow create, update: if false;
      }
      match /careWaterHistory/{revisionId} {
        allow read, delete: if ownsPlant(plantId) && get(/databases/$(database)/documents/plants/$(plantId)).data.get('deleting', false) == true;
        allow create, update: if false;
      }
      match /careWeather/{revisionId} {
        // Backend-only acquisition/revision data; owners may clean it up when deleting their plant.
        allow delete: if ownsPlant(plantId) && get(/databases/$(database)/documents/plants/$(plantId)).data.get('deleting', false) == true;
        allow read: if ownsPlant(plantId) && get(/databases/$(database)/documents/plants/$(plantId)).data.get('deleting', false) == true;
        allow create, update: if false;
      }
      match /logs/{logId} {
        allow read: if ownsPlant(plantId);
        allow delete: if ownsPlant(plantId) && (get(/databases/$(database)/documents/plants/$(plantId)).data.get('deleting', false) == true
          || !(resource.data.get('type', '') in ['watering', 'fertilizing']) || advancesCareRevision(plantId));
        allow create: if ownsPlantAfter(plantId) && request.resource.data.updatedBy == request.auth.uid
          && (!(request.resource.data.get('type', '') in ['watering', 'fertilizing']) || advancesCareRevision(plantId));
        allow update: if ownsPlantAfter(plantId) && request.resource.data.updatedBy == request.auth.uid
          && (!(resource.data.get('type', '') in ['watering', 'fertilizing'] || request.resource.data.get('type', '') in ['watering', 'fertilizing'])
            || advancesCareRevision(plantId));
      }
      match /progressPics/{picId} {
        allow read, delete: if ownsPlant(plantId);
        allow create, update: if ownsPlantAfter(plantId) && request.resource.data.imageUrl is string;
      }
      match /weatherCache/{date} {
        allow read, delete: if ownsPlant(plantId);
        allow create, update: if ownsPlantAfter(plantId);
      }
    }
    match /groups/{groupId} {
      match /weatherCache/{date} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
      }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/groups/$(groupId)) || resource.data.createdBy == request.auth.uid);
      allow list, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    match /sensorProfiles/{profileId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/sensorProfiles/$(profileId)) || resource.data.createdBy == request.auth.uid);
      allow list, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;
    }
  }
}
