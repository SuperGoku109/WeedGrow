rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsPlant(id) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/plants/$(id)).data.owners;
    }
    function ownsPlantAfter(id) {
      return signedIn() && request.auth.uid in getAfter(/databases/$(database)/documents/plants/$(id)).data.owners
        && getAfter(/databases/$(database)/documents/plants/$(id)).data.get('deleting', false) != true;
    }
    function validPlant() {
      return request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.growthStage in ['germination', 'seedling', 'vegetative', 'flowering', 'clone']
        && request.resource.data.environment in ['outdoor', 'indoor', 'greenhouse']
        && request.resource.data.plantedIn in ['pot', 'ground'];
    }
    // Sanitized diagnostics only: one capped record per account, no raw user content.
    match /clientDiagnostics/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if false; // A client cannot reset its daily cap by deleting the record.
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['day', 'count', 'lastSeenAt', 'operation', 'code', 'platform', 'version', 'severity'])
        && request.resource.data.day == int(request.time.toMillis() / 86400000)
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 20
        && ((!exists(/databases/$(database)/documents/clientDiagnostics/$(uid)) && request.resource.data.count == 1)
          || (exists(/databases/$(database)/documents/clientDiagnostics/$(uid)) && ((request.resource.data.day == resource.data.day && request.resource.data.count == resource.data.count + 1) || (request.resource.data.day != resource.data.day && request.resource.data.count == 1))))
        && request.resource.data.operation in ['handled', 'save', 'weather', 'render', 'unhandled']
        && request.resource.data.code in ['unknown', 'unavailable', 'deadline-exceeded', 'permission-denied', 'unauthenticated', 'network-request-failed', 'resource-exhausted']
        && request.resource.data.platform in ['web', 'android', 'ios']
        && request.resource.data.version is string && request.resource.data.version.matches('[0-9]+[.][0-9]+[.][0-9]+') && request.resource.data.version.size() <= 20
        && request.resource.data.severity in ['error', 'fatal'];
    }
    match /plants/{plantId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/plants/$(plantId)) || request.auth.uid in resource.data.owners);
      allow list: if signedIn() && request.auth.uid in resource.data.owners;
      allow create: if signedIn() && request.resource.data.owners == [request.auth.uid] && validPlant()
        && request.resource.data.get('careSummary', null) == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid in resource.data.owners && validPlant()
        && (request.resource.data.get('careSummary', null) == null || (request.resource.data.careSummary.version == 1 && request.resource.data.careSummary.revision == request.resource.data.get('careRevision', 0)))
        && request.resource.data.owners == resource.data.owners
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if ownsPlant(plantId);
      match /photoAssets/{assetId} {
        allow read, delete: if ownsPlant(plantId);
        allow create: if ownsPlantAfter(plantId) && request.resource.data.keys().hasOnly(['dataUri'])
          && request.resource.data.dataUri is string
          && request.resource.data.dataUri.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
          && request.resource.data.dataUri.size() <= (assetId.matches('.*_thumb') ? 20480 : 184320);
        allow update: if false;
      }
      match /logs/{logId} {
        allow read, delete: if ownsPlant(plantId);
        allow create, update: if ownsPlantAfter(plantId) && request.resource.data.updatedBy == request.auth.uid;
      }
      match /progressPics/{picId} {
        allow read, delete: if ownsPlant(plantId);
        allow create, update: if ownsPlantAfter(plantId) && request.resource.data.imageUrl is string;
      }
      match /weatherCache/{date} {
        allow read, delete: if ownsPlant(plantId);
        allow create, update: if ownsPlantAfter(plantId);
      }
    }
    match /groups/{groupId} {
      match /weatherCache/{date} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
      }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/groups/$(groupId)) || resource.data.createdBy == request.auth.uid);
      allow list, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    match /sensorProfiles/{profileId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/sensorProfiles/$(profileId)) || resource.data.createdBy == request.auth.uid);
      allow list, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;
    }
  }
}
